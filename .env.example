# 浏览器可见：只填写 Supabase 项目 URL 与 public anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅服务端使用：绝对不要暴露、截图或提交到 GitHub
SUPABASE_SERVICE_ROLE_KEY=

# 用于 README 提示和首位管理员配置，不参与前端鉴权
ADMIN_EMAIL=

# 正式域名，用于分享与 SEO，例如 https://love.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access Code和Access Session分别使用独立的高强度服务端密钥
ACCESS_CODE_HASH_SECRET=
ACCESS_SESSION_HASH_SECRET=
ACCESS_RATE_LIMIT_SECRET=

# 测试窗口与正式结果只读查看窗口
ACCESS_TEST_TTL_HOURS=72
RESULT_VIEW_TTL_DAYS=30
