# 浏览器可见：只填写 Supabase 项目 URL 与 public anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅服务端使用：绝对不要暴露、截图或提交到 GitHub
SUPABASE_SERVICE_ROLE_KEY=

# 用于 README 提示和首位管理员配置，不参与前端鉴权
ADMIN_EMAIL=

# 正式域名，用于分享与 SEO，例如 https://love.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：只有获得小红书提供的真实商品跳转能力后才填写；留空时页面不生成购买链接
NEXT_PUBLIC_XHS_PRODUCT_URL=

# 未来小红书官方身份与订单接入（当前适配层标记为 PENDING_XHS_PLATFORM_INTEGRATION）
XHS_APP_ID=
XHS_PREMIUM_PRODUCT_ID=
XHS_PLATFORM_SIGNING_SECRET=

# 仅限 development / test 的服务端 fixture；production 无论此值为何都不会授权
XHS_ENTITLEMENT_FIXTURE=not-entitled
XHS_FIXTURE_SIGNING_SECRET=
